NODE_ENV=development
PORT=4000
APP_NAME=SFM PRO Enterprise API
API_VERSION=6.2.0
DATABASE_URL=postgresql://postgres:password@localhost:5432/sfm_pro_enterprise
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-separate-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
COOKIE_SECURE=false
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs
